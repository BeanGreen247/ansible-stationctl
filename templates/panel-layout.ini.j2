[org/mate/panel/general]
toplevel-id-list=['bottom']
object-id-list=['menu-bar', 'window-list', 'notification-area', 'indicators', 'separator', {% if machine_role == 'bare-metal' %}'battery', {% endif %}'ram-status', 'sysmonitor', 'clock']

[org/mate/panel/toplevels/bottom]
orientation='bottom'
# Legacy XEmbed tray icons (nm-applet, mate-volume-control-status-icon)
# render at EXACTLY this panel height with zero internal padding —
# confirmed via `xwininfo`, their embedded windows were literally 32x32
# at size=32, while native panel applets/SNI icons pad themselves and
# looked proportionate at the same height. There's no separate icon-size
# knob for the legacy tray (checked org.mate.panel.toplevel's schema —
# nothing), so panel height is the only real lever. 24 confirmed live
# (dconf write + screenshot) to make those two proportionate again
# without making text/other applets illegible; bumped to 28 per a later
# explicit size request.
size=28
auto-hide=false
expand=true

[org/mate/panel/objects/menu-bar]
object-type='menu-bar'
toplevel-id='bottom'
position=0
panel-right-stick=false

[org/mate/panel/objects/window-list]
object-type='applet'
applet-iid='WnckletFactory::WindowListApplet'
toplevel-id='bottom'
position=50
panel-right-stick=false

[org/mate/panel/objects/notification-area]
object-type='applet'
applet-iid='NotificationAreaAppletFactory::NotificationArea'
toplevel-id='bottom'
position=7
panel-right-stick=true

# StatusNotifierItem/AppIndicator host — Qt6 apps (dotfile-sync-tray,
# infra-connections) need this since Qt6 dropped legacy XEmbed tray
# support; the notification-area applet above only hosts XEmbed.
[org/mate/panel/objects/indicators]
object-type='applet'
applet-iid='IndicatorAppletCompleteFactory::IndicatorAppletComplete'
toplevel-id='bottom'
position=8
panel-right-stick=true

# Visual spacer between the notification/tray cluster and the sysmonitor
# graphs. NOT MATE's native 'separator' object-type — that one draws a
# themed groove/line via a hardcoded Cairo render call inside mate-panel
# itself (panel_separator_change_background / gtk_render_line), which
# isn't reachable through GTK CSS at all (confirmed: even a blanket
# `* { color: red !important }` in /etc/gtk-3.0/gtk.css had zero visual
# effect on it — GTK wasn't even loading that stylesheet for mate-panel
# in the first place). A blank Command applet has no border/background
# of its own (same as ram-status/battery-status-adjacent text elsewhere
# on this panel — always rendered as bare text with no visible box), so
# an empty one is just invisible spacing by construction, no CSS needed.
[org/mate/panel/objects/separator]
object-type='applet'
applet-iid='CommandAppletFactory::CommandApplet'
toplevel-id='bottom'
position=6
panel-right-stick=true

[org/mate/panel/objects/separator/prefs]
command='/usr/local/bin/stationctl-blank.sh'
interval=3600
show-icon=false
width=16

{% if machine_role == 'bare-metal' %}
# Battery charge — MATE's own native panel applet (battstat, from
# mate-applets), not a systray icon. Chosen after several tray-icon
# attempts (PyQt6 QSystemTrayIcon-drawn icons) kept getting squeezed
# into whatever tiny square the SNI/indicator host allocates for tray
# icons, no matter how large the source pixmap was rendered — a native
# panel applet draws straight onto the panel like sysmonitor below, so
# it isn't subject to that ceiling and reads live state via its own
# upower hooks instead of a custom poll loop.
[org/mate/panel/objects/battery]
object-type='applet'
applet-iid='BattstatAppletFactory::BattstatApplet'
toplevel-id='bottom'
position=9
panel-right-stick=true

[org/mate/panel/objects/battery/prefs]
show-text=1
{% endif %}

[org/mate/panel/objects/ram-status]
object-type='applet'
applet-iid='CommandAppletFactory::CommandApplet'
toplevel-id='bottom'
position=10
panel-right-stick=true

[org/mate/panel/objects/ram-status/prefs]
command='/usr/local/bin/stationctl-ram-status.sh'
interval=4
show-icon=false
width=22

[org/mate/panel/objects/sysmonitor]
object-type='applet'
applet-iid='MultiLoadAppletFactory::MultiLoadApplet'
toplevel-id='bottom'
position=5
panel-right-stick=true

[org/mate/panel/objects/sysmonitor/prefs]
view-cpuload=true
view-memload=true
view-netload=true
view-swapload=true
view-diskload=false
view-loadavg=false
speed=2000
size=40

[org/mate/panel/objects/clock]
object-type='applet'
applet-iid='ClockAppletFactory::ClockApplet'
toplevel-id='bottom'
position=0
panel-right-stick=true

[org/mate/panel/objects/clock/prefs]
show-seconds=false
show-date=true
